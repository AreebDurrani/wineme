#!/bin/bash

cores=$(nproc)

# Check if the script is being run as root
if [ "$EUID" -ne 0 ]; then
    echo "This script must be run as root (use sudo)."
    exit 1
fi

# Helper function to find a file recursively and extract it
find_and_extract() {
    local pattern="$1"
    # Search recursively for the pattern and grab the first match
    local file_path
    file_path=$(find . -type f -name "$pattern" | head -n 1)

    if [ -z "$file_path" ]; then
        echo "Error: Could not find any archive matching '$pattern' recursively."
        exit 1
    fi

    echo "Extracting: $file_path"
    tar -xvf "$file_path" || exit 1
}

# Initial setup - Find and extract all tarballs recursively
find_and_extract "Python-*.tar.xz"
find_and_extract "flit_core-*.tar.gz"
find_and_extract "packaging-*.tar.gz"
find_and_extract "wheel-*.tar.gz"
find_and_extract "setuptools-*.tar.gz"
find_and_extract "ninja-*.tar.gz"
find_and_extract "meson-*.tar.gz"

# Python
(
    cd Python-*/ || exit 1
    ./configure --enable-optimizations
    make -j"$cores"
    make -j"$cores" install
)

# flit_core
(
    cd flit_core-*/ || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --find-links dist flit_core
)

# packaging
(
    cd packaging-*/ || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --find-links dist packaging
)

# wheel
(
    cd wheel-*/ || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --find-links dist wheel
)

# setuptools
(
    cd setuptools-*/ || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --find-links dist setuptools
)

# ninja
(
    cd ninja-*/ || exit 1
    python3 configure.py --bootstrap --verbose
    install -vm755 ninja /usr/local/bin/
    install -vDm644 misc/bash-completion /usr/local/share/bash-completion/completions/ninja
    install -vDm644 misc/zsh-completion  /usr/local/share/zsh/site-functions/_ninja
)

# meson
(
    cd meson-*/ || exit 1
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps "$PWD"
    pip3 install --no-index --find-links dist meson
    install -vDm644 data/shell-completions/bash/meson /usr/local/share/bash-completion/completions/meson
    install -vDm644 data/shell-completions/zsh/_meson /usr/local/share/zsh/site-functions/_meson
)
