#!/bin/bash

installdir="/usr/local"
realdir="$(realpath "$installdir")"
workingdir="$PWD"
cores=$(nproc)

# Syncing dependencies
rsync -aPivh other-deps/binutils-with-gold*.tar.xz "$workingdir"
rsync -aPivh other-deps/mingw-w64*.tar.bz2 "$workingdir"
rsync -aPivh other-deps/gcc*.patch "$workingdir"
rsync -aPivh wineme-deps/mpfr*.tar.xz "$workingdir"
rsync -aPivh wineme-deps/gmp*.tar.xz "$workingdir"
rsync -aPivh wineme-deps/mpc*.tar.gz "$workingdir"
rsync -aPivh wineme-deps/gcc*.tar.xz "$workingdir"

# Helper function to find an archive recursively and extract it
find_and_extract() {
    local pattern="$1"
    local file_path
    file_path=$(find "$workingdir" -type f -name "$pattern" | head -n 1)

    if [ -z "$file_path" ]; then
        echo "Error: Could not find any archive matching '$pattern' recursively."
        exit 1
    fi

    echo "Extracting: $file_path"
    tar -xvf "$file_path" || exit 1
}

addgccdeps() {
    find_and_extract "mpfr*.tar.*"
    # The trailing slash ensures we only move the extracted directory, not the tarball
    mv -v mpfr-[0-9]*/ mpfr || exit 1

    find_and_extract "gmp*.tar.*"
    mv -v gmp-[0-9]*/ gmp || exit 1

    find_and_extract "mpc*.tar.*"
    mv -v mpc-[0-9]*/ mpc || exit 1
}

# Check if the script is being run as root
if [ "$EUID" -ne 0 ]; then
    echo "This script must be run as root (use sudo)."
    exit 1
fi

# Initial setup - Find and extract main tarballs recursively
find_and_extract "binutils-with-gold-*.tar.*"
find_and_extract "gcc-[0-9]*.tar.*"
find_and_extract "mingw-w64-*.tar.*"

# ==========================================
# MinGW-w64 Headers
# ==========================================
(
# Trailing slash ensures we only target the directory
cd mingw-w64-*/ || exit 1

mkdir build-x86_64-headers
(
cd build-x86_64-headers || exit 1
../mingw-w64-headers/configure --prefix="$realdir"/x86_64-w64-mingw32 \
                               --host=x86_64-w64-mingw32        \
                               --enable-sdk=all                 \
                               --with-default-msvcrt=msvcrt
make -j"$cores" install || exit 1
) || exit 1

mkdir build-i686-headers
(
cd build-i686-headers || exit 1
../mingw-w64-headers/configure --prefix="$realdir"/i686-w64-mingw32 \
                               --host=i686-w64-mingw32        \
                               --enable-sdk=all               \
                               --with-default-msvcrt=msvcrt
make -j"$cores" install || exit 1
) || exit 1
)

# ==========================================
# Binutils with Gold
# ==========================================
(
cd binutils-with-gold-*/ || exit 1

mkdir build-x86_64
(
cd build-x86_64 || exit 1
../configure --prefix="$realdir"                                \
             --target=x86_64-w64-mingw32                  \
             --infodir="$realdir"/share/info/x86_64-w64-mingw32 \
             --disable-nls                                \
             --disable-werror                             \
             --with-gold=no

make -j"$cores" || exit 1
make -j"$cores" DESTDIR="$PWD"/DESTDIR install
rm -v DESTDIR"$realdir"/lib/bfd-plugins/libdep.so
cp -Rv DESTDIR"$realdir"/* "$realdir"
rm -rf DESTDIR
) || exit 1

mkdir build-i686
(
cd build-i686 || exit 1
../configure --prefix="$realdir"                              \
             --target=i686-w64-mingw32                  \
             --infodir="$realdir"/share/info/i686-w64-mingw32 \
             --disable-nls                              \
             --disable-werror                           \
             --with-gold=no

make -j"$cores" || exit 1
make -j"$cores" DESTDIR="$PWD"/DESTDIR install
rm -v DESTDIR"$realdir"/lib/bfd-plugins/libdep.so
cp -Rv DESTDIR"$realdir"/* "$realdir"
rm -rf DESTDIR
) || exit 1
)

# ==========================================
# Static MinGW-w64-GCC
# ==========================================
(
cd gcc-[0-9]*/ || exit 1

# Find the patch recursively and apply it
patch_file=$(find "$workingdir" -type f -name "gcc*.patch" | head -n 1)
if [ -n "$patch_file" ]; then
    patch -Np1 -i "$patch_file"
else
    echo "Warning: No GCC patch found."
fi

# Only extract dependencies ONCE in the root gcc source tree!
addgccdeps

mkdir build-x86_64-mingw-w64-static
(
cd build-x86_64-mingw-w64-static || exit 1
../configure --prefix="$realdir"         \
             --target=x86_64-w64-mingw32 \
             --disable-shared            \
             --disable-multilib          \
             --disable-threads           \
             --enable-languages=c,c++    \
             CXXFLAGS="-g -O2 -fno-char8_t" \
             BOOT_CXXFLAGS="-g -O2 -fno-char8_t"

make -j"$cores" all-gcc || exit 1
make -j"$cores" install-gcc
) || exit 1

mkdir build-i686-mingw-w64-static
(
cd build-i686-mingw-w64-static || exit 1
../configure --prefix="$realdir"         \
             --target=i686-w64-mingw32 \
             --disable-shared            \
             --disable-multilib          \
             --disable-threads           \
             --enable-languages=c,c++    \
             CXXFLAGS="-g -O2 -fno-char8_t" \
             BOOT_CXXFLAGS="-g -O2 -fno-char8_t"

make -j"$cores" all-gcc || exit 1
make -j"$cores" install-gcc
) || exit 1
)

# ==========================================
# MinGW-w64 CRT & Winpthreads
# ==========================================
(
cd mingw-w64-*/ || exit 1

mkdir build-x86_64
(
cd build-x86_64 || exit 1
../configure --prefix="$realdir"/x86_64-w64-mingw32 \
             --host=x86_64-w64-mingw32        \
             --disable-lib32                  \
             --enable-experimental            \
             --with-default-msvcrt=msvcrt

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1

mkdir build-x86_64-winpthreads
(
cd build-x86_64-winpthreads || exit 1
../mingw-w64-libraries/winpthreads/configure \
            --prefix="$realdir"/x86_64-w64-mingw32 \
            --host=x86_64-w64-mingw32        \
            --disable-lib32                  \
            --with-default-msvcrt=msvcrt

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1

mkdir build-i686
(
cd build-i686 || exit 1
../configure --prefix="$realdir"/i686-w64-mingw32 \
             --host=i686-w64-mingw32        \
             --disable-lib64                  \
             --enable-experimental            \
             --with-default-msvcrt=msvcrt

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1

mkdir build-i686-winpthreads
(
cd build-i686-winpthreads || exit 1
../mingw-w64-libraries/winpthreads/configure \
            --prefix="$realdir"/i686-w64-mingw32 \
            --host=i686-w64-mingw32        \
            --disable-lib64                  \
            --with-default-msvcrt=msvcrt

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1
)

# ==========================================
# Final Shared MinGW-w64-GCC
# ==========================================
(
cd gcc-[0-9]*/ || exit 1

mkdir build-x86_64-mingw-w64
(
cd build-x86_64-mingw-w64 || exit 1
../configure --prefix="$realdir"               \
             --target=x86_64-w64-mingw32 \
             --enable-threads=posix      \
             --enable-shared             \
             --disable-multilib          \
             --enable-languages=c,c++    \
             CXXFLAGS="-g -O2 -fno-char8_t"  \
             BOOT_CXXFLAGS="-g -O2 -fno-char8_t"

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1

ln -sfv x86_64-w64-mingw32-gcc "$realdir"/bin/x86_64-w64-mingw32-cc
strip "$realdir"/libexec/gcc/x86_64-w64-mingw32/*/{cc1*,collect2,lto*}

mkdir build-i686-mingw-w64
(
cd build-i686-mingw-w64 || exit 1
../configure --prefix="$realdir"               \
             --target=i686-w64-mingw32 \
             --enable-threads=posix      \
             --enable-shared             \
             --disable-multilib          \
             --enable-languages=c,c++ \
             CXXFLAGS="-g -O2 -fno-char8_t"  \
             BOOT_CXXFLAGS="-g -O2 -fno-char8_t"

make -j"$cores" || exit 1
make -j"$cores" install
) || exit 1

ln -sfv i686-w64-mingw32-gcc "$realdir"/bin/i686-w64-mingw32-cc
strip "$realdir"/libexec/gcc/i686-w64-mingw32/*/{cc1*,collect2,lto*}
)

# ==========================================
# Tests
# ==========================================
echo "int main(){}" >> main.c
cp -v main.c main.cpp
gcc main.c
./a.out
rm -v a.out

g++ main.cpp
./a.out
rm -v a.out main.{c,cpp}

cat >> main.c << "EOF"
#include <stdio.h>
int main(){}
EOF

cp main.{c,cpp}
sed -i 's/stdio.h/iostream/g' main.cpp

x86_64-w64-mingw32-gcc main.c
rm -v a.exe
x86_64-w64-mingw32-g++ main.cpp
rm -v a.exe main.{c,cpp}

cat >> main.c << "EOF"
#include <stdio.h>
int main(){}
EOF

cp main.{c,cpp}
sed -i 's/stdio.h/iostream/g' main.cpp

i686-w64-mingw32-gcc main.c
rm -v a.exe
i686-w64-mingw32-g++ main.cpp
rm -v a.exe main.{c,cpp}
