#!/bin/bash

MY_PATH="$(realpath "$0")"
MY_DIR="$(dirname "$MY_PATH")"

rm -rvf "$(realpath ~)"/.cache/winetricks

(
cd dxvk || exit 1
mkdir -pv "$(realpath ~)"/.cache/winetricks/dxvk
./package-release.sh release "$(realpath ~/.cache/winetricks/dxvk)" || exit 1
)

(
cd vkd3d-proton || exit 1
mkdir -pv "$(realpath ~)"/.cache/winetricks/vkd3d
./package-release.sh release "$(realpath ~/.cache/winetricks/vkd3d)" || exit 1
)

"$MY_DIR"/winetricks dxvk vkd3d || exit 1

